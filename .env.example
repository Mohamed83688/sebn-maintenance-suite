# ==============================================================
# SEBN-TN Enterprise Maintenance Suite — Environment Configuration
# ==============================================================

# Flask Settings
FLASK_ENV=production
FLASK_APP=web_portal.app:app
FLASK_DEBUG=0
PORT=5000
HOST=0.0.0.0

# Security Secret Key (Generate a random 64-character hex string)
# Example: python -c "import secrets; print(secrets.token_hex(32))"
SEBN_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

# HTTPS Enforcement (Set to 1 in production on Railway)
SEBN_HTTPS=1

# Persistent Storage Directory for Railway Volume Mounts
# When mounting a Railway Volume (e.g. at /data or /app/data), set this path:
# SEBN_DATA_DIR=/data
SEBN_DATA_DIR=

# Email / Notification SMTP Configuration (Optional)
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USER=maintenance-alerts@sebn.com
SMTP_PASSWORD=your_smtp_password
SMTP_SENDER=maintenance-alerts@sebn.com
