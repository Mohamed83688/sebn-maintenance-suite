# ==============================================================
# SEBN-TN Enterprise Maintenance Suite — Environment Configuration
# ==============================================================

# Flask Settings
FLASK_ENV=production
FLASK_APP=run.py
FLASK_DEBUG=0
PORT=5000
HOST=0.0.0.0

# Secret Key (Generate a random 64-character hex string)
SEBN_SECRET_KEY=change-this-to-a-secure-random-secret-key

# HTTPS Enforcement (1 to enable Secure Cookies over HTTPS)
SEBN_HTTPS=0

# Application Base Storage Directory (leave blank for default ./data)
SEBN_DATA_DIR=

# Email / Notification SMTP Configuration (Optional)
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USER=maintenance-alerts@sebn.com
SMTP_PASSWORD=your_smtp_password
SMTP_SENDER=maintenance-alerts@sebn.com
